{
  "name": "@talaljaber/vibesafe-cli",
  "version": "0.5.0",
  "description": "The don't-deploy-that-yet tool for vibe-coded apps — CLI",
  "license": "MIT",
  "author": "Talal Jaber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talaljaber/Vibesafe.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Talaljaber/Vibesafe#readme",
  "bugs": {
    "url": "https://github.com/Talaljaber/Vibesafe/issues"
  },
  "type": "module",
  "bin": {
    "vibesafe": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@talaljaber/vibesafe-attack": "workspace:*",
    "@talaljaber/vibesafe-core": "workspace:*",
    "@talaljaber/vibesafe-shared": "workspace:*",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "figlet": "^1.11.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/figlet": "^1.7.0",
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
