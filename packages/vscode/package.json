{
  "name": "vibeguard-scanner",
  "version": "0.3.0",
  "icon": "icon.png",
  "displayName": "VibeSafe by Talal Jaber",
  "description": "VibeSafe VS Code Extension — pre-deploy safety scanner for vibe-coded apps",
  "license": "MIT",
  "galleryBanner": {
    "color": "#0f111a",
    "theme": "dark"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "vibe coding",
    "scanner",
    "secrets",
    "code quality"
  ],
  "publisher": "talaljaber",
  "repository": {
    "type": "git",
    "url": "https://github.com/Talaljaber/Vibesafe"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:jiti --format=cjs --platform=node",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist *.tsbuildinfo",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibesafe",
          "title": "VibeSafe",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "vibesafe": [
        {
          "id": "vibesafe.deployStatus",
          "name": "Deploy Status",
          "type": "webview"
        },
        {
          "id": "vibesafe.issues",
          "name": "Issues",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "vibesafe.scan",
        "title": "VibeSafe: Scan Project",
        "icon": "$(shield)"
      },
      {
        "command": "vibesafe.openDashboard",
        "title": "VibeSafe: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "vibesafe.rescan",
        "title": "VibeSafe: Re-scan",
        "icon": "$(refresh)"
      },
      {
        "command": "vibesafe.copyFixPrompt",
        "title": "VibeSafe: Copy Fix Prompt",
        "icon": "$(copy)"
      },
      {
        "command": "vibesafe.applyFix",
        "title": "VibeSafe: Apply Safe Fix",
        "icon": "$(wrench)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vibesafe.copyFixPrompt",
          "when": "false"
        },
        {
          "command": "vibesafe.applyFix",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "vibesafe.scan",
          "when": "view == vibesafe.issues",
          "group": "navigation@1"
        },
        {
          "command": "vibesafe.openDashboard",
          "when": "view == vibesafe.issues",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "vibesafe.copyFixPrompt",
          "when": "view == vibesafe.issues && viewItem =~ /^finding/",
          "group": "inline@1"
        },
        {
          "command": "vibesafe.applyFix",
          "when": "view == vibesafe.issues && viewItem == findingWithFix",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "VibeSafe",
      "properties": {
        "vibesafe.enabledCategories": {
          "type": "array",
          "default": [],
          "description": "Categories to enable. Empty array means all categories are enabled."
        },
        "vibesafe.minSeverity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "default": "low",
          "description": "Minimum severity level to show in the sidebar."
        },
        "vibesafe.focusProblemsOnScan": {
          "type": "boolean",
          "default": false,
          "description": "Focus the Problems panel after a scan that finds issues."
        },
        "vibesafe.scanOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan the project when a workspace is opened."
        },
        "vibesafe.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run VibeSafe whenever you save a file. Might cause performance issues in very large codebases."
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "dependencies": {
    "@vibesafe/core": "workspace:*",
    "@vibesafe/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
