{
  "name": "@talaljaber/vibesafe-mcp",
  "version": "0.5.0",
  "description": "The don't-deploy-that-yet tool for vibe-coded apps — MCP server",
  "license": "MIT",
  "author": "Talal Jaber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talaljaber/Vibesafe.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/Talaljaber/Vibesafe#readme",
  "bugs": {
    "url": "https://github.com/Talaljaber/Vibesafe/issues"
  },
  "type": "module",
  "bin": {
    "vibesafe-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@talaljaber/vibesafe-core": "workspace:*",
    "@talaljaber/vibesafe-shared": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
